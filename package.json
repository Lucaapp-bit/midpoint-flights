<!doctype html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MidPoint · dove incontrarci</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
<style>
:root{
  --ink:#0a0e1a;--ink-2:#111726;--panel:#161d30;--panel-2:#1c2540;--line:#263252;
  --mist:#8a97b8;--text:#eaf0ff;--text-dim:#b3bede;
  --a:#ffb347;--a-deep:#f0932b;--b:#4fd6e0;--b-deep:#2bb8d4;--meet:#c9a6ff;
  --ok:#6ee7a8;--warn:#ff8a8a;--r:14px;--shadow:0 20px 60px -20px rgba(0,0,0,.7);
}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(900px 500px at 12% -5%,rgba(240,147,43,.14),transparent 60%),radial-gradient(900px 500px at 90% 8%,rgba(43,184,212,.14),transparent 60%),var(--ink);color:var(--text);font-family:"Space Grotesk",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.page{max-width:1120px;margin:0 auto;padding:28px 22px 80px;position:relative;overflow:hidden}
.orbit{position:absolute;border-radius:50%;filter:blur(2px);opacity:.35;pointer-events:none;border:1px solid transparent}
.orbit-a{width:520px;height:520px;top:-160px;left:-180px;border-color:rgba(255,179,71,.25)}
.orbit-b{width:600px;height:600px;top:-220px;right:-220px;border-color:rgba(79,214,224,.22)}
@media(prefers-reduced-motion:no-preference){.orbit-a{animation:drift 22s ease-in-out infinite}.orbit-b{animation:drift 26s ease-in-out infinite reverse}}
@keyframes drift{0%,100%{transform:translate(0,0)}50%{transform:translate(24px,20px)}}
.masthead{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}
.brand{display:flex;align-items:center;gap:12px;font-family:"Fraunces",serif;font-weight:900;font-size:22px;letter-spacing:-.02em}
.brand-mark{position:relative;width:26px;height:26px;display:inline-block}
.brand-mark i{position:absolute;top:50%;width:15px;height:15px;border-radius:50%;transform:translateY(-50%);mix-blend-mode:screen}
.brand-mark .mark-a{left:0;background:var(--a)}.brand-mark .mark-b{right:0;background:var(--b)}
.provider{font-family:"JetBrains Mono",monospace;font-size:11px;padding:5px 10px;border-radius:999px;border:1px solid var(--line);color:var(--mist);text-transform:uppercase;letter-spacing:.08em}
.provider-amadeus{color:var(--ok);border-color:rgba(110,231,168,.4)}
.hero{margin:56px 0 34px;position:relative;z-index:2}
.hero h1{font-family:"Fraunces",serif;font-weight:900;font-size:clamp(38px,7vw,76px);line-height:.98;letter-spacing:-.03em;margin:0 0 20px}
.hero h1 em{font-style:italic;background:linear-gradient(100deg,var(--a),var(--meet) 50%,var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{max-width:560px;font-size:17px;line-height:1.55;color:var(--text-dim);margin:0}
.hero-sub strong{color:var(--text)}
.console{background:linear-gradient(180deg,var(--panel),var(--ink-2));border:1px solid var(--line);border-radius:22px;padding:26px;box-shadow:var(--shadow);position:relative;z-index:2}
.cities{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:14px}
.converge{display:flex;flex-direction:column;align-items:center;padding-bottom:14px;gap:4px}
.conv-line{width:2px;height:16px;background:linear-gradient(var(--a),var(--meet))}
.converge .conv-line:last-child{background:linear-gradient(var(--meet),var(--b))}
.conv-node{width:12px;height:12px;border-radius:50%;background:var(--meet);box-shadow:0 0 0 4px rgba(201,166,255,.18)}
.city-input{position:relative}
.city-input label{display:flex;align-items:center;gap:7px;font-size:12.5px;letter-spacing:.02em;color:var(--mist);margin-bottom:8px}
.city-input .dot{width:9px;height:9px;border-radius:50%}
.traveler-a .dot{background:var(--a)}.traveler-b .dot{background:var(--b)}
.city-input input{width:100%;background:var(--ink);border:1.5px solid var(--line);border-radius:var(--r);padding:15px 16px;color:var(--text);font-size:16px;font-family:inherit;transition:border-color .15s,box-shadow .15s}
.traveler-a input:focus{outline:none;border-color:var(--a);box-shadow:0 0 0 3px rgba(255,179,71,.16)}
.traveler-b input:focus{outline:none;border-color:var(--b);box-shadow:0 0 0 3px rgba(79,214,224,.16)}
.options{list-style:none;margin:6px 0 0;padding:6px;position:absolute;z-index:20;left:0;right:0;background:var(--panel-2);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);max-height:260px;overflow:auto}
.options li{display:flex;flex-direction:column;gap:2px;padding:10px 12px;border-radius:9px;cursor:pointer}
.options li.active{background:rgba(255,255,255,.06)}
.opt-city{font-weight:500}.opt-meta{font-size:12px;color:var(--mist)}
.opt-meta code,.options code{font-family:"JetBrains Mono",monospace}
.names{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:12px}
.names input{background:transparent;border:none;border-bottom:1.5px solid var(--line);padding:6px 2px;color:var(--text);font-family:inherit;font-size:14px}
.names input:focus{outline:none}
.name-a{border-bottom-color:rgba(255,179,71,.5)!important}
.name-b{border-bottom-color:rgba(79,214,224,.5)!important;text-align:right}
.controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:20px}
.ctl{display:flex;flex-direction:column;gap:7px}
.ctl span{font-size:12.5px;color:var(--mist)}
.ctl input{background:var(--ink);border:1.5px solid var(--line);border-radius:10px;padding:12px 13px;color:var(--text);font-family:inherit;font-size:15px;color-scheme:dark}
.ctl input:focus{outline:none;border-color:var(--meet)}
.ctl input:disabled{opacity:.4}
.toggles{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
.toggle{background:var(--ink);border:1.5px solid var(--line);color:var(--text-dim);padding:10px 16px;border-radius:999px;font-family:inherit;font-size:13.5px;cursor:pointer;transition:all .15s}
.toggle.on{border-color:var(--meet);color:var(--text);background:rgba(201,166,255,.1)}
.go{width:100%;margin-top:22px;padding:17px;border:none;border-radius:var(--r);font-family:"Fraunces",serif;font-weight:600;font-size:18px;letter-spacing:-.01em;color:var(--ink);background:linear-gradient(100deg,var(--a),var(--meet) 52%,var(--b));cursor:pointer;transition:transform .12s,filter .15s}
.go:hover:not(:disabled){transform:translateY(-1px);filter:brightness(1.06)}
.go:disabled{opacity:.45;cursor:not-allowed}
.hint{font-size:13px;margin:10px 0 0}.hint.warn{color:var(--warn)}
.results{margin-top:40px;position:relative;z-index:2}
.results-meta{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:18px;color:var(--text-dim);font-size:14px}
.results-meta strong{color:var(--text);font-size:16px}
.sort-note{font-family:"JetBrains Mono",monospace;font-size:12px;color:var(--mist)}
.cards{display:grid;gap:14px}
.result{display:grid;grid-template-columns:54px 1fr;gap:4px;background:linear-gradient(180deg,var(--panel),var(--ink-2));border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:border-color .15s,transform .15s}
.result:hover{transform:translateY(-2px);border-color:#34436e}
.result.is-best{border:1.5px solid transparent;background:linear-gradient(var(--panel),var(--ink-2)) padding-box,linear-gradient(120deg,var(--a),var(--meet),var(--b)) border-box}
.result-rank{display:flex;align-items:flex-start;justify-content:center;padding-top:22px;font-family:"JetBrains Mono",monospace;font-size:14px;color:var(--mist);background:rgba(0,0,0,.18)}
.result.is-best .result-rank{color:var(--meet);font-size:20px}
.result-main{padding:20px 22px}
.result-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.result-head h3{font-family:"Fraunces",serif;font-weight:600;font-size:26px;letter-spacing:-.02em;margin:0}
.result-country{margin:2px 0 0;font-size:13px;color:var(--mist)}
.result-country code{font-family:"JetBrains Mono",monospace}
.result-total{text-align:right;display:flex;flex-direction:column}
.total-num{font-family:"Fraunces",serif;font-weight:900;font-size:30px;letter-spacing:-.02em}
.total-lbl{font-size:11.5px;color:var(--mist);margin-top:2px}
.best-tag{align-self:flex-end;margin-top:8px;font-size:11px;font-family:"JetBrains Mono",monospace;text-transform:uppercase;letter-spacing:.06em;color:var(--ink);background:var(--meet);padding:3px 9px;border-radius:999px}
.split{display:flex;height:8px;border-radius:999px;overflow:hidden;margin:18px 0 16px;background:var(--ink)}
.split-a{background:linear-gradient(90deg,var(--a-deep),var(--a))}
.split-b{background:linear-gradient(90deg,var(--b),var(--b-deep))}
.legs{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:560px){.legs{grid-template-columns:1fr}}
.leg{display:flex;gap:10px}
.leg-dot{width:10px;height:10px;border-radius:50%;margin-top:5px;flex:none}
.leg-a .leg-dot{background:var(--a)}.leg-b .leg-dot{background:var(--b)}
.leg-body{flex:1}
.leg-top{display:flex;justify-content:space-between;align-items:baseline}
.leg-name{font-size:13.5px;color:var(--text-dim)}
.leg-price{font-family:"JetBrains Mono",monospace;font-weight:500;font-size:16px}
.leg-route{display:flex;align-items:center;gap:7px;margin-top:3px;font-size:12.5px;color:var(--mist)}
.leg-route code{font-family:"JetBrains Mono",monospace;color:var(--text-dim)}
.leg-route .arrow{color:var(--line)}.leg-flags{margin-left:auto;font-size:11.5px}
.result-foot{display:flex;gap:10px;align-items:center;margin-top:16px;padding-top:14px;border-top:1px solid var(--line);flex-wrap:wrap}
.fair{font-family:"JetBrains Mono",monospace;font-size:12px;padding:4px 10px;border-radius:999px}
.fair-hi{color:var(--ok);background:rgba(110,231,168,.12)}
.fair-mid{color:var(--a);background:rgba(255,179,71,.12)}
.fair-lo{color:var(--warn);background:rgba(255,138,138,.12)}
.chip{font-size:12px;color:var(--text-dim);border:1px solid var(--line);padding:4px 10px;border-radius:999px}
.chip.subtle{color:var(--mist)}
.skeletons{display:grid;gap:14px}
.skeleton{height:150px;border-radius:18px;background:linear-gradient(100deg,var(--panel) 30%,var(--panel-2) 50%,var(--panel) 70%);background-size:200% 100%;animation:shimmer 1.3s linear infinite}
@keyframes shimmer{to{background-position:-200% 0}}
.empty,.error{padding:22px;border-radius:var(--r);border:1px dashed var(--line);color:var(--text-dim);text-align:center}
.error{color:var(--warn);border-color:rgba(255,138,138,.4)}
.site-foot{display:flex;justify-content:space-between;margin-top:50px;padding-top:20px;border-top:1px solid var(--line);color:var(--mist);font-size:12.5px;position:relative;z-index:2}
@media(max-width:680px){.cities{grid-template-columns:1fr}.converge{flex-direction:row;padding:4px 0}.converge .conv-line{width:16px;height:2px}.controls{grid-template-columns:1fr}.result-head{flex-direction:column}.result-total{text-align:left}.best-tag{align-self:flex-start}}
</style>
</head>
<body>
<div id="root"></div>

<script type="module">
// ============================================================
// MidPoint — vanilla JS (no build step). Works two ways:
//  • Deployed on Vercel  -> calls /api/* (real serverless functions)
//  • Opened as a file    -> falls back to the embedded mock below
// ============================================================

const AIRPORTS = [
  ["LHR","London","UK",51.47,-0.4543,1],["CDG","Paris","France",49.0097,2.5479,1],
  ["AMS","Amsterdam","Netherlands",52.3105,4.7683,1],["FRA","Frankfurt","Germany",50.0379,8.5622,1],
  ["MAD","Madrid","Spain",40.4936,-3.5668,1],["BCN","Barcelona","Spain",41.2974,2.0833,1],
  ["FCO","Rome","Italy",41.8003,12.2389,1],["MXP","Milan","Italy",45.6306,8.7281,1],
  ["MUC","Munich","Germany",48.3538,11.7861,1],["BER","Berlin","Germany",52.3667,13.5033,1],
  ["VIE","Vienna","Austria",48.1103,16.5697,1],["ZRH","Zurich","Switzerland",47.4647,8.5492,0],
  ["LIS","Lisbon","Portugal",38.7742,-9.1342,1],["OPO","Porto","Portugal",41.2481,-8.6814,0],
  ["DUB","Dublin","Ireland",53.4213,-6.2701,1],["CPH","Copenhagen","Denmark",55.618,12.6508,1],
  ["ARN","Stockholm","Sweden",59.6519,17.9186,0],["OSL","Oslo","Norway",60.1939,11.1004,0],
  ["HEL","Helsinki","Finland",60.3172,24.9633,0],["PRG","Prague","Czechia",50.1008,14.26,1],
  ["BUD","Budapest","Hungary",47.4369,19.2556,1],["WAW","Warsaw","Poland",52.1657,20.9671,1],
  ["KRK","Krakow","Poland",50.0777,19.7848,0],["ATH","Athens","Greece",37.9364,23.9445,1],
  ["IST","Istanbul","Turkey",41.2753,28.7519,1],["SAW","Istanbul (Sabiha)","Turkey",40.8986,29.3092,1],
  ["BRU","Brussels","Belgium",50.9014,4.4844,1],["GVA","Geneva","Switzerland",46.2381,6.109,0],
  ["EDI","Edinburgh","UK",55.95,-3.3725,0],["MAN","Manchester","UK",53.3537,-2.275,1],
  ["NAP","Naples","Italy",40.886,14.2908,0],["VCE","Venice","Italy",45.5053,12.3519,0],
  ["SVQ","Seville","Spain",37.418,-5.8931,0],["VLC","Valencia","Spain",39.4893,-0.4816,0],
  ["PMI","Palma de Mallorca","Spain",39.5517,2.7388,0],["NCE","Nice","France",43.6584,7.2159,0],
  ["LYS","Lyon","France",45.7256,5.0811,0],["HAM","Hamburg","Germany",53.6304,9.9882,0],
  ["DUS","Dusseldorf","Germany",51.2895,6.7668,1],["GDN","Gdansk","Poland",54.3776,18.4662,0],
  ["RIX","Riga","Latvia",56.9236,23.9711,0],["TLL","Tallinn","Estonia",59.4133,24.8328,0],
  ["SOF","Sofia","Bulgaria",42.6952,23.4062,0],["OTP","Bucharest","Romania",44.5711,26.085,1],
  ["ZAG","Zagreb","Croatia",45.7429,16.0688,0],["SPU","Split","Croatia",43.5389,16.2981,0],
  ["TIA","Tirana","Albania",41.4147,19.7206,0],["MLA","Malta","Malta",35.8575,14.4775,0],
  ["KEF","Reykjavik","Iceland",63.985,-22.6056,0]
].map(([code,city,country,lat,lon,hub])=>({code,city,country,lat,lon,hub:!!hub}));

const byCode = new Map(AIRPORTS.map(a=>[a.code,a]));
const distanceKm=(a,b)=>{const R=6371,t=d=>d*Math.PI/180,dLat=t(b.lat-a.lat),dLon=t(b.lon-a.lon),h=Math.sin(dLat/2)**2+Math.cos(t(a.lat))*Math.cos(t(b.lat))*Math.sin(dLon/2)**2;return 2*R*Math.asin(Math.sqrt(h))};
function seededRand(s){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}h^=h>>>13;return((h>>>0)%100000)/100000}

function localSearchAirports(q){const s=(q||"").trim().toLowerCase();if(!s)return[];return AIRPORTS.filter(a=>a.city.toLowerCase().includes(s)||a.country.toLowerCase().includes(s)||a.code.toLowerCase()===s).slice(0,8)}

function localMockPrice({origin,destination,departDate,returnDate,nonStop}){
  const a=byCode.get(origin),b=byCode.get(destination);
  if(!a||!b||origin===destination)return null;
  const km=distanceKm(a,b);if(km<150)return null;
  const r=seededRand(`${origin}-${destination}-${departDate}-${returnDate||"ow"}`);
  const perKm=a.hub&&b.hub?0.055:(a.hub||b.hub?0.075:0.095);
  let base=28+km*perKm;if(returnDate)base*=1.8;base*=0.65+r*0.7;
  const dow=new Date(departDate).getUTCDay();if(dow===5||dow===6)base*=1.12;
  const likelyDirect=km<2500&&(a.hub||b.hub);
  if(nonStop&&!likelyDirect){if(r<0.5)return null;base*=1.25}
  const durationMinutes=Math.round(45+km/12+(nonStop?0:70*r));
  return{price:Math.round(base),currency:"EUR",nonStop:nonStop?true:(likelyDirect&&r>0.4),durationMinutes,origin,destination}
}

function localMeetingPoints({originA,originB,departDate,returnDate,nonStop,maxTotalBudget,limit}){
  const dests=AIRPORTS.filter(a=>a.code!==originA&&a.code!==originB).map(a=>a.code);
  const out=[];
  for(const dest of dests){
    const fa=localMockPrice({origin:originA,destination:dest,departDate,returnDate,nonStop});
    const fb=localMockPrice({origin:originB,destination:dest,departDate,returnDate,nonStop});
    if(!fa||!fb)continue;
    const total=fa.price+fb.price;
    if(maxTotalBudget&&total>Number(maxTotalBudget))continue;
    const ap=byCode.get(dest),diff=Math.abs(fa.price-fb.price),fairness=total===0?1:1-diff/total;
    out.push({destination:{code:dest,city:ap.city,country:ap.country},travelerA:fa,travelerB:fb,total,currency:fa.currency,priceDiff:diff,fairness:Number(fairness.toFixed(2)),combinedDurationMinutes:(fa.durationMinutes||0)+(fb.durationMinutes||0),bothNonStop:fa.nonStop&&fb.nonStop})
  }
  out.sort((x,y)=>x.total-y.total||y.fairness-x.fairness||x.combinedDurationMinutes-y.combinedDurationMinutes);
  return{count:out.length,provider:"mock (offline)",results:out.slice(0,limit)}
}

// If served over http(s) we have the API; if opened as file:// we don't.
const HAS_API = location.protocol.startsWith("http");

async function apiSearchAirports(q){
  if(!HAS_API) return localSearchAirports(q);
  try{const r=await fetch(`/api/airports?q=${encodeURIComponent(q)}`);if(!r.ok)throw 0;return await r.json()}
  catch{return localSearchAirports(q)}
}
async function apiMeetingPoints(payload){
  if(!HAS_API) return localMeetingPoints(payload);
  try{
    const r=await fetch("/api/meeting-points",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
    const d=await r.json();if(!r.ok)throw new Error(d.error||"Errore");return d;
  }catch(e){ // API missing/failing -> graceful offline fallback
    return localMeetingPoints(payload);
  }
}

// ---------- tiny DOM helpers ----------
const fmt=(n,c="EUR")=>new Intl.NumberFormat("it-IT",{style:"currency",currency:c,maximumFractionDigits:0}).format(n);
const mins=m=>m==null?"—":`${Math.floor(m/60)}h ${String(m%60).padStart(2,"0")}m`;
const el=(tag,attrs={},...kids)=>{const e=document.createElement(tag);for(const[k,v]of Object.entries(attrs)){if(k==="class")e.className=v;else if(k.startsWith("on"))e.addEventListener(k.slice(2),v);else if(k==="html")e.innerHTML=v;else e.setAttribute(k,v)}for(const kid of kids.flat()){if(kid==null)continue;e.append(kid.nodeType?kid:document.createTextNode(kid))}return e};
const todayISO=()=>new Date().toISOString().slice(0,10);
const plusDays=(base,n)=>{const d=new Date(base);d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)};

// ---------- state ----------
const state={a:null,b:null,nameA:"Tu",nameB:"Lei / Lui",depart:plusDays(todayISO(),30),ret:plusDays(todayISO(),33),roundTrip:true,nonStop:false,budget:"",loading:false,error:"",data:null,provider:HAS_API?null:"mock (offline)"};

// ---------- autocomplete input ----------
function cityInput(traveler,label,onPick){
  const wrap=el("div",{class:`city-input traveler-${traveler}`});
  const lab=el("label",{},el("span",{class:"dot"}),label);
  const input=el("input",{type:"text",placeholder:"Città o aeroporto…",autocomplete:"off","aria-label":label});
  const list=el("ul",{class:"options",role:"listbox"});list.style.display="none";
  let opts=[],active=0,timer;
  const render=()=>{list.innerHTML="";if(!opts.length){list.style.display="none";return}list.style.display="block";
    opts.forEach((a,i)=>{const li=el("li",{role:"option",class:i===active?"active":"",onmousedown:e=>{e.preventDefault();pick(a)},onmouseenter:()=>{active=i;render()}},el("span",{class:"opt-city"},a.city),el("span",{class:"opt-meta",html:`${a.country} · <code>${a.code}</code>`}));list.append(li)})};
  const pick=a=>{onPick(a);input.value=`${a.city} (${a.code})`;opts=[];render()};
  input.addEventListener("input",()=>{onPick(null);clearTimeout(timer);const q=input.value;timer=setTimeout(async()=>{if(q.length<2){opts=[];return render()}opts=await apiSearchAirports(q);active=0;render()},180)});
  input.addEventListener("keydown",e=>{if(!opts.length)return;if(e.key==="ArrowDown"){e.preventDefault();active=Math.min(active+1,opts.length-1);render()}else if(e.key==="ArrowUp"){e.preventDefault();active=Math.max(active-1,0);render()}else if(e.key==="Enter"){e.preventDefault();pick(opts[active])}else if(e.key==="Escape"){opts=[];render()}});
  document.addEventListener("mousedown",e=>{if(!wrap.contains(e.target)){opts=[];render()}});
  wrap.append(lab,input,list);return wrap;
}

// ---------- result card ----------
function leg(side,name,l,currency){
  return el("div",{class:`leg leg-${side}`},el("span",{class:"leg-dot"}),
    el("div",{class:"leg-body"},
      el("div",{class:"leg-top"},el("span",{class:"leg-name"},name),el("span",{class:"leg-price"},fmt(l.price,currency))),
      el("div",{class:"leg-route"},el("code",{},l.origin),el("span",{class:"arrow"},"→"),el("code",{},l.destination),
        el("span",{class:"leg-flags"},`${l.nonStop?"diretto":"scalo"} · ${mins(l.durationMinutes)}`))));
}
function resultCard(item,rank,labels){
  const{destination:d,travelerA:A,travelerB:B,total,currency,fairness}=item;
  const aShare=(A.price/total)*100;
  const fairClass=fairness>=0.75?"fair-hi":fairness>=0.5?"fair-mid":"fair-lo";
  const head=el("div",{class:"result-head"},
    el("div",{},el("h3",{},d.city),el("p",{class:"result-country",html:`${d.country} · <code>${d.code}</code>`})),
    el("div",{class:"result-total"},el("span",{class:"total-num"},fmt(total,currency)),el("span",{class:"total-lbl"},"totale a/r combinato"),rank===0?el("span",{class:"best-tag"},"più conveniente"):null));
  const split=el("div",{class:"split"},el("div",{class:"split-a"}),el("div",{class:"split-b"}));
  split.children[0].style.width=aShare+"%";split.children[1].style.width=(100-aShare)+"%";
  const foot=el("div",{class:"result-foot"},
    el("span",{class:`fair ${fairClass}`},`equità split ${Math.round(fairness*100)}%`),
    item.bothNonStop?el("span",{class:"chip"},"entrambi diretti"):null,
    el("span",{class:"chip subtle"},`volo tot ${mins(item.combinedDurationMinutes)}`));
  return el("article",{class:`result ${rank===0?"is-best":""}`},
    el("div",{class:"result-rank"},rank===0?"★":String(rank+1).padStart(2,"0")),
    el("div",{class:"result-main"},head,split,
      el("div",{class:"legs"},leg("a",labels.a,A,currency),leg("b",labels.b,B,currency)),foot));
}

// ---------- main render ----------
const root=document.getElementById("root");
function App(){
  root.innerHTML="";
  const page=el("div",{class:"page"});
  page.append(el("div",{class:"orbit orbit-a"}),el("div",{class:"orbit orbit-b"}));

  // masthead
  page.append(el("div",{class:"masthead"},
    el("div",{class:"brand"},el("span",{class:"brand-mark"},el("i",{class:"mark-a"}),el("i",{class:"mark-b"})),"MidPoint"),
    state.provider?el("span",{class:`provider provider-${state.provider.startsWith("amadeus")?"amadeus":"mock"}`},`dati: ${state.provider.startsWith("amadeus")?"amadeus":"demo"}`):null));

  // hero
  page.append(el("section",{class:"hero"},
    el("h1",{html:`Due partenze.<br><em>Un punto d'incontro</em><br>al prezzo più basso.`}),
    el("p",{class:"hero-sub",html:`Voi partite da città diverse e volete vedervi in una terza. MidPoint trova le destinazioni raggiungibili da entrambi e le ordina per <strong>costo totale dei due biglietti</strong>.`})));

  // console
  const console_=el("section",{class:"console"});
  const refreshGo=()=>{const ok=state.a&&state.b&&state.a.code!==state.b.code&&state.depart;go.disabled=!(ok&&!state.loading);
    const w=console_.querySelector(".hint.warn");if(state.a&&state.b&&state.a.code===state.b.code){if(!w)console_.append(el("p",{class:"hint warn"},"Scegliete due città di partenza diverse."))}else if(w)w.remove()};
  const cities=el("div",{class:"cities"});
  cities.append(cityInput("a","Chi parte da qui",v=>{state.a=v;refreshGo()}),
    el("div",{class:"converge"},el("span",{class:"conv-line"}),el("span",{class:"conv-node"}),el("span",{class:"conv-line"})),
    cityInput("b","…e chi da qui",v=>{state.b=v;refreshGo()}));
  console_.append(cities);

  const names=el("div",{class:"names"});
  const nA=el("input",{class:"name-a",value:state.nameA,"aria-label":"Nome A"});nA.addEventListener("input",e=>state.nameA=e.target.value);
  const nB=el("input",{class:"name-b",value:state.nameB,"aria-label":"Nome B"});nB.addEventListener("input",e=>state.nameB=e.target.value);
  names.append(nA,nB);console_.append(names);

  const controls=el("div",{class:"controls"});
  const dDep=el("input",{type:"date",value:state.depart,min:todayISO()});dDep.addEventListener("change",e=>state.depart=e.target.value);
  const dRet=el("input",{type:"date",value:state.ret,min:state.depart});if(!state.roundTrip)dRet.disabled=true;dRet.addEventListener("change",e=>state.ret=e.target.value);
  const bud=el("input",{type:"number",placeholder:"nessun limite",min:"0",value:state.budget});bud.addEventListener("input",e=>state.budget=e.target.value);
  controls.append(el("label",{class:"ctl"},el("span",{},"Andata"),dDep),el("label",{class:"ctl"},el("span",{},"Ritorno"),dRet),el("label",{class:"ctl budget"},el("span",{},"Budget totale max"),bud));
  console_.append(controls);

  const toggles=el("div",{class:"toggles"});
  const tRT=el("button",{type:"button",class:`toggle ${state.roundTrip?"on":""}`},state.roundTrip?"Andata e ritorno":"Solo andata");
  tRT.addEventListener("click",()=>{state.roundTrip=!state.roundTrip;App()});
  const tNS=el("button",{type:"button",class:`toggle ${state.nonStop?"on":""}`},state.nonStop?"Solo voli diretti":"Diretti + scali");
  tNS.addEventListener("click",()=>{state.nonStop=!state.nonStop;App()});
  toggles.append(tRT,tNS);console_.append(toggles);

  const go=el("button",{class:"go"},state.loading?"Cerco i punti d'incontro…":"Trova dove vedervi");
  const canSearch=state.a&&state.b&&state.a.code!==state.b.code&&state.depart;
  if(!canSearch||state.loading)go.disabled=true;
  go.addEventListener("click",run);
  console_.append(go);
  if(state.a&&state.b&&state.a.code===state.b.code)console_.append(el("p",{class:"hint warn"},"Scegliete due città di partenza diverse."));
  refreshGo();
  page.append(console_);

  // results
  const results=el("section",{class:"results"});
  if(state.error)results.append(el("p",{class:"error"},state.error));
  if(state.loading){const sk=el("div",{class:"skeletons"});[0,1,2].forEach(()=>sk.append(el("div",{class:"skeleton"})));results.append(sk)}
  if(state.data&&!state.loading){
    const labels={a:state.nameA.trim()||"Viaggiatore A",b:state.nameB.trim()||"Viaggiatore B"};
    results.append(el("div",{class:"results-meta"},
      el("span",{html:`<strong>${state.data.results.length}</strong> punti d'incontro trovati${state.data.count>state.data.results.length?` su ${state.data.count}`:""}`}),
      el("span",{class:"sort-note"},"ordinati per costo totale ↑")));
    if(state.data.results.length===0){results.append(el("div",{class:"empty"},"Nessuna città raggiungibile da entrambi con questi filtri. Prova ad alzare il budget o a includere i voli con scalo."))}
    else{const cards=el("div",{class:"cards"});state.data.results.forEach((it,i)=>cards.append(resultCard(it,i,labels)));results.append(cards)}
  }
  page.append(results);

  page.append(el("footer",{class:"site-foot"},el("span",{},"MidPoint · dimostrazione"),
    el("span",{},state.provider&&state.provider.startsWith("amadeus")?"Tariffe live.":"Prezzi generati per la demo. Collega Amadeus per tariffe reali.")));

  root.append(page);
}

async function run(){
  if(!(state.a&&state.b&&state.a.code!==state.b.code&&state.depart))return;
  state.loading=true;state.error="";state.data=null;App();
  try{
    const res=await apiMeetingPoints({originA:state.a.code,originB:state.b.code,departDate:state.depart,returnDate:state.roundTrip?state.ret:null,nonStop:state.nonStop,maxTotalBudget:state.budget?Number(state.budget):null,limit:12});
    state.data=res;if(res.provider)state.provider=res.provider;
  }catch(e){state.error=e.message}
  finally{state.loading=false;App()}
}

// probe provider on load (only if API present)
if(HAS_API){fetch("/api/airports?q=ist").then(r=>r.ok?fetch("/api/meeting-points",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({originA:"IST",originB:"LHR",departDate:state.depart,limit:1})}):null).then(r=>r&&r.json()).then(d=>{if(d&&d.provider){state.provider=d.provider;App()}}).catch(()=>{})}

App();
</script>
</body>
</html>
